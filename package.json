{
  "name": "dsh-need-router",
  "version": "0.2.0",
  "description": "Capability router for DeepSeek Harness: map one request to capability domains, the skills actually installed on this machine, and the tools visible in this session. 需求判断器：把请求映射到能力域、本机已装技能与本会话可见工具。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "agent",
    "agent-skills",
    "skills",
    "router",
    "skill-routing",
    "capability",
    "intent-routing",
    "llm"
  ],
  "author": "ken688",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ken688/dsh-need-router.git"
  },
  "homepage": "https://github.com/ken688/dsh-need-router#readme",
  "bugs": {
    "url": "https://github.com/ken688/dsh-need-router/issues"
  }
}
